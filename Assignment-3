# Q7: CONTACT MERGING PROGRAM
# Merge duplicate contacts using normalised phone numbers and email addresses.


# --------------------------------------------------
# 1. NORMALISATION FUNCTIONS
# --------------------------------------------------

def normalize_phone(phone):
    if not phone:
        return ""

    digits = "".join(ch for ch in str(phone) if ch.isdigit())

    # Convert Indian numbers into a common 10-digit format
    if len(digits) == 12 and digits.startswith("91"):
        digits = digits[2:]

    return digits


def normalize_email(email):
    if not email:
        return ""

    return email.strip().lower()


def normalize_name(name):
    if not name:
        return ""

    return " ".join(name.strip().lower().split())


# --------------------------------------------------
# 2. CONTACT MERGING USING A DICTIONARY
# --------------------------------------------------

def merge_contacts(contacts):

    merged = []

    phone_index = {}
    email_index = {}

    for contact in contacts:

        name = contact.get("name", "").strip()
        phone = normalize_phone(contact.get("phone", ""))
        email = normalize_email(contact.get("email", ""))

        # Find existing groups using phone or email
        matching_groups = set()

        if phone and phone in phone_index:
            matching_groups.add(phone_index[phone])

        if email and email in email_index:
            matching_groups.add(email_index[email])

        if not matching_groups:

            # Create a new contact group
            group = {
                "names": set(),
                "numbers": set(),
                "emails": set()
            }

            merged.append(group)

        else:

            # Use the first matching group
            group = matching_groups.pop()

            # Merge any other matching groups
            for other_group in matching_groups:

                group["names"].update(other_group["names"])
                group["numbers"].update(other_group["numbers"])
                group["emails"].update(other_group["emails"])

                merged.remove(other_group)

                # Update indexes pointing to the merged group
                for number in other_group["numbers"]:
                    phone_index[number] = group

                for mail in other_group["emails"]:
                    email_index[mail] = group

        # Add the current contact details
        if name:
            group["names"].add(name)

        if phone:
            group["numbers"].add(phone)
            phone_index[phone] = group

        if email:
            group["emails"].add(email)
            email_index[email] = group

    # Prepare readable output
    result = []

    for group in merged:

        result.append({
            "names": sorted(group["names"]),
            "phone_numbers": sorted(group["numbers"]),
            "emails": sorted(group["emails"])
        })

    return result


# --------------------------------------------------
# 3. ORIGINAL METHOD: COMPARING EVERY PAIR
# --------------------------------------------------

def pairwise_merge(contacts):

    groups = []

    for contact in contacts:

        name = contact.get("name", "").strip()
        phone = normalize_phone(contact.get("phone", ""))
        email = normalize_email(contact.get("email", ""))

        matching_groups = []

        for group in groups:

            same_phone = (
                phone and phone in group["numbers"]
            )

            same_email = (
                email and email in group["emails"]
            )

            if same_phone or same_email:
                matching_groups.append(group)

        if not matching_groups:

            group = {
                "names": set(),
                "numbers": set(),
                "emails": set()
            }

            groups.append(group)

        else:

            group = matching_groups[0]

            for other_group in matching_groups[1:]:

                group["names"].update(other_group["names"])
                group["numbers"].update(other_group["numbers"])
                group["emails"].update(other_group["emails"])

                groups.remove(other_group)

        if name:
            group["names"].add(name)

        if phone:
            group["numbers"].add(phone)

        if email:
            group["emails"].add(email)

    return groups


