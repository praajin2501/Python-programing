    result, dictionary_time = measure_time(
        merge_contacts, test_data
    )

    print("\nInput Contacts:", size)
    print("Merged Contacts:", len(result))
    print(
        "Dictionary Method Time:",
        round(dictionary_time, 6),
        "seconds"
    )

    print("Estimated Pairwise Comparisons:",
          size * (size - 1) // 2)

    # Pairwise method is measured on 1,000 contacts only.
    # 100,000 contacts would require billions of comparisons.
    if size == 1000:

        pairwise_result, pairwise_time = measure_time(
            pairwise_merge, test_data
        )

        print(
            "Pairwise Method Time:",
            round(pairwise_time, 6),
