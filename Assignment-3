# 7. GENERATE LARGE TEST DATA
# --------------------------------------------------

def generate_contacts(size):

    random.seed(42)

    data = []

    for i in range(size):

        person_id = i // 2

        phone = "98400" + str(10000 + person_id)
        email = "person" + str(person_id) + "@gmail.com"

        if i % 2 == 0:
            data.append({
                "name": "Person " + str(person_id),
                "phone": "+91 " + phone,
                "email": email
            })

        else:
            data.append({
                "name": "person " + str(person_id),
                "phone": phone,
                "email": email.upper()
            })

    return data


# --------------------------------------------------
# 8. PERFORMANCE MEASUREMENT
# --------------------------------------------------

def measure_time(function, data):

    start = time.perf_counter()

    result = function(data)

    end = time.perf_counter()

    return result, end - start


print("\nPERFORMANCE MEASUREMENT")
print("=" * 50)

