# =====================================================
# B4.2: DATABASE AND INDEX PERFORMANCE
# =====================================================

def database_test():

    print("\nDATABASE INDEX PERFORMANCE")
    print("=" * 55)

    connection = sqlite3.connect(":memory:")
    cursor = connection.cursor()

    cursor.execute("""
        CREATE TABLE readings (
            id INTEGER PRIMARY KEY,
            station TEXT,
            day TEXT,
            time TEXT,
            air_quality REAL
        )
    """)

    # Generate readings for 100 stations.
    # Each station reports every 15 minutes.
    stations = 100
    days = 30
    readings_per_day = 96

    data = []

    for station_no in range(1, stations + 1):

        station_name = f"ST{station_no:03}"

        for day_no in range(1, days + 1):

            day = f"2026-11-{day_no:02}"

            for reading_no in range(readings_per_day):

                hour = reading_no // 4
                minute = (reading_no % 4) * 15

                time_value = f"{hour:02}:{minute:02}"

                air_quality = random.uniform(20, 200)

                data.append((
                    station_name,
                    day,
                    time_value,
                    round(air_quality, 2)
                ))

    cursor.executemany("""
        INSERT INTO readings
        (station, day, time, air_quality)
        VALUES (?, ?, ?, ?)
    """, data)

    connection.commit()

    print("Total stations:", stations)
    print("Total days:", days)
    print("Readings per day:", readings_per_day)
    print("Total database records:", len(data))

    query = """
        SELECT AVG(air_quality)
        FROM readings
        WHERE station = ? AND day = ?
    """

    parameters = ("ST050", "2026-11-15")

    # Measure query before indexing
    start = time.perf_counter()

    for _ in range(100):
        cursor.execute(query, parameters)
        cursor.fetchone()

    before_index = time.perf_counter() - start

    print("\nQuery time before index:",
          round(before_index, 6), "seconds")

    # Create composite index
    cursor.execute("""
        CREATE INDEX idx_station_day
        ON readings(station, day)
    """)

    connection.commit()

    # Measure query after indexing
    start = time.perf_counter()

    for _ in range(100):
        cursor.execute(query, parameters)
        cursor.fetchone()

    after_index = time.perf_counter() - start

    print("Query time after index:",
          round(after_index, 6), "seconds")

    if after_index > 0:

        improvement = before_index / after_index

        print("Index performance ratio:",
              round(improvement, 2), "times")

    if before_index > after_index:
        print("Result: Index improved query performance.")

    else:
        print(
            "Result: No measurable improvement in this test. "
            "Small timing differences can occur."
        )

    connection.close()


