# =====================================================
# TEST SENTIMENT AND COMPARE WITH MANUAL LABELS
# =====================================================

def test_sentiment():

    agreement = 0

    print("\nSENTIMENT ANALYSIS RESULTS")
    print("=" * 75)

    for index, (complaint, actual_label) in enumerate(complaints, 1):

        predicted_label = label(complaint)

        if predicted_label == actual_label:
            agreement += 1

        print(
            f"{index:02}. Predicted: {predicted_label:8} "
            f"| Manual: {actual_label:8} | {complaint}"
        )

    accuracy = (agreement / len(complaints)) * 100

    print("\nTotal Complaints:", len(complaints))
    print("Correct Labels:", agreement)
    print("Incorrect Labels:", len(complaints) - agreement)
    print("Agreement:", round(accuracy, 2), "%")

    return agreement


# =====================================================
# COMPARE THE TWO SUMMARISERS
# =====================================================

def test_summariser():

    print("\nSUMMARISER COMPARISON")
    print("=" * 75)

    frequency_better = 0
    first_k_better = 0
    equal = 0

    for index, (complaint, manual_label) in enumerate(complaints, 1):

        frequency_summary = summarise(complaint, 2)
        first_summary = first_k_summary(complaint, 2)

        # Compare whether the summaries retain the complaint's
        # important sentiment words.
        important_words = POSITIVE | NEGATIVE

        frequency_count = sum(
            word in important_words
            for word in re.findall(r"[a-z]+", frequency_summary.lower())
        )

        first_count = sum(
            word in important_words
            for word in re.findall(r"[a-z]+", first_summary.lower())
        )

        if frequency_count > first_count:
            frequency_better += 1

        elif first_count > frequency_count:
            first_k_better += 1

        else:
            equal += 1

        print(f"\nComplaint {index}: {complaint}")
        print("Frequency Summary:", frequency_summary)
        print("First-K Summary:", first_summary)

    print("\nSUMMARY COMPARISON")
    print("Frequency-based summary better:", frequency_better)
    print("First-K summary better:", first_k_better)
    print("Equal results:", equal)


