POSITIVE = {"good", "clean", "fast", "helpful", "improved"}
NEGATIVE = {"bad", "dirty", "slow", "rude", "smoke", "broken"}
NEGATORS = {"not", "never", "no"}

STOP_WORDS = {
    "the", "is", "are", "was", "were", "a", "an", "and",
    "to", "of", "in", "from", "it", "this", "that",
    "at", "on", "for", "with", "but", "very", "my",
    "our", "we", "they", "i", "have", "has", "had"
}


# =====================================================
# B4.1: SENTIMENT SCORER
# =====================================================

def score(text):
    words = re.findall(r"[a-z]+", text.lower())
    total = 0

    for i, word in enumerate(words):

        value = 0

        if word in POSITIVE:
            value = 1

        elif word in NEGATIVE:
            value = -1

        # A preceding negator reverses the sentiment
        if i > 0 and words[i - 1] in NEGATORS:
            value = -value

        total += value

    return total


def label(text):

    sentiment = score(text)

    if sentiment > 0:
        return "positive"

    elif sentiment < 0:
        return "negative"

    else:
        return "neutral"


# =====================================================
# SUMMARISER: SELECT SENTENCES USING WORD FREQUENCY
# =====================================================

def summarise(text, k=2):

    sentences = re.split(r"(?<=[.!?])\s+", text.strip())
    sentences = [s for s in sentences if s]

    if len(sentences) <= k:
        return " ".join(sentences)

    words = re.findall(r"[a-z]+", text.lower())

    important_words = [
        word for word in words
        if word not in STOP_WORDS and len(word) > 2
    ]

    word_frequency = Counter(important_words)

    sentence_scores = []

    for index, sentence in enumerate(sentences):

        sentence_words = re.findall(r"[a-z]+", sentence.lower())

        sentence_score = sum(
            word_frequency[word]
            for word in sentence_words
            if word not in STOP_WORDS
        )

        sentence_scores.append((sentence_score, index, sentence))

    selected = sorted(
        sentence_scores,
        key=lambda item: item[0],
        reverse=True
    )[:k]

    # Preserve the original sentence order
    selected.sort(key=lambda item: item[1])

    return " ".join(item[2] for item in selected)


# =====================================================
# ALTERNATIVE SUMMARISER: FIRST K SENTENCES
# =====================================================

def first_k_summary(text, k=2):

    sentences = re.split(r"(?<=[.!?])\s+", text.strip())

    return " ".join(sentences[:k])


